# Puertos publicados en el host
MQTT_PORT=1883
INFLUXDB_PORT=8086
GRAFANA_PORT=3001

# Autenticación MQTT general
MQTT_USERNAME=esp32
MQTT_PASSWORD=CAMBIAR_MQTT_PASSWORD
MQTT_PASSWORD_FILE=./mosquitto/config/passwd

# Tópicos MQTT
MQTT_ENV_TOPIC=smart-environment-sensor/bme680/state
MQTT_ENV_OUTDOOR_TOPIC=smart-environment-sensor/outdoor/state
MQTT_ENERGY_TOPIC=smart-energy/tuya/energia
MQTT_MIKROTIK_TOPIC=mikrotik/router/wan

# Autenticación MQTT de MikroTik
MQTT_MIKROTIK_USER=mikrotik
MQTT_MIKROTIK_PASSWORD=CAMBIAR_MQTT_MIKROTIK_PASSWORD

# Bases InfluxDB
INFLUXDB_ENERGY_DB=tuya
INFLUXDB_ENV_DB=smart_environment
INFLUXDB_NETWORK_DB=network

# Acceso inicial de Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CAMBIAR_GRAFANA_ADMIN_PASSWORD

{
  "uid": "environment-sensor-v1",
  "title": "Monitor Ambiental",
  "tags": ["environment", "bme680"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "10s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Temperatura", "gridPos": {"x": 0, "y": 0, "w": 8, "h": 5}, "datasource": {"type": "influxdb", "uid": "environment-influxdb"}, "targets": [{"refId": "A", "query": "SELECT last(\"temperature_c\") FROM \"environment\" WHERE $timeFilter", "rawQuery": true, "resultFormat": "time_series"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"}, "fieldConfig": {"defaults": {"unit": "celsius", "decimals": 1}}},
    {"id": 2, "type": "stat", "title": "Humedad", "gridPos": {"x": 8, "y": 0, "w": 8, "h": 5}, "datasource": {"type": "influxdb", "uid": "environment-influxdb"}, "targets": [{"refId": "A", "query": "SELECT last(\"humidity_percent\") FROM \"environment\" WHERE $timeFilter", "rawQuery": true, "resultFormat": "time_series"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"}, "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1}}},
    {"id": 3, "type": "stat", "title": "Presión", "gridPos": {"x": 16, "y": 0, "w": 8, "h": 5}, "datasource": {"type": "influxdb", "uid": "environment-influxdb"}, "targets": [{"refId": "A", "query": "SELECT last(\"pressure_hpa\") FROM \"environment\" WHERE $timeFilter", "rawQuery": true, "resultFormat": "time_series"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"}, "fieldConfig": {"defaults": {"unit": "pressurehpa", "decimals": 1}}},
    {"id": 4, "type": "timeseries", "title": "Condiciones ambientales", "gridPos": {"x": 0, "y": 5, "w": 24, "h": 12}, "datasource": {"type": "influxdb", "uid": "environment-influxdb"}, "targets": [{"refId": "A", "query": "SELECT mean(\"temperature_c\") FROM \"environment\" WHERE $timeFilter GROUP BY time($__interval) fill(null)", "rawQuery": true, "alias": "Temperatura (°C)", "resultFormat": "time_series"}, {"refId": "B", "query": "SELECT mean(\"humidity_percent\") FROM \"environment\" WHERE $timeFilter GROUP BY time($__interval) fill(null)", "rawQuery": true, "alias": "Humedad (%)", "resultFormat": "time_series"}, {"refId": "C", "query": "SELECT mean(\"pressure_hpa\") FROM \"environment\" WHERE $timeFilter GROUP BY time($__interval) fill(null)", "rawQuery": true, "alias": "Presión (hPa)", "resultFormat": "time_series"}], "fieldConfig": {"defaults": {"custom": {"lineWidth": 2, "fillOpacity": 8}}}, "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}}
  ]
}
